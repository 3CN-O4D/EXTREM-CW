{
  "framework": null,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/v1/(.*)", "dest": "/api/index.ts" },
    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/images/(.*)", "dest": "/frontend/images/$1" },
    { "src": "/favicon.svg", "dest": "/frontend/favicon.svg" },
    { "src": "/icons.svg", "dest": "/frontend/icons.svg" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}